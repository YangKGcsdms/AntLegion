.eslintcache

# Runtime state — never commit. The bus journal (ANTLEGION_DATA_DIR, default
# .data-v2/) and the colony residency dir (.ant/ — pid, logs, prompts, and the
# agent's cross-wake working memory) are produced wherever you run the tools,
# so match them at any depth, not just at the repo root.
.data-v2/
.data/
.ant/
*.jsonl
*.jsonl.tmp
*.log

