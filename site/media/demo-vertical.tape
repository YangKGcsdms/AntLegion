# vhs script — vertical recording for 公众号竖版截图组 (9:16)
# Reproduce: cd <recdir> && vhs <repo>/site/media/demo-vertical.tape
# Stills are extracted afterwards with ffmpeg (see site/media/README.md)
Output demo-vertical.gif
Set FontSize 14
Set Width 640
Set Height 1136
Set Padding 16
Set TypingSpeed 45ms
Type "npx @antlegion/bus demo"
Enter
Sleep 17s
