{
  "name": "antlegion-bus",
  "version": "0.1.0",
  "description": "Node.js/TypeScript implementation of the AntLegion Bus protocol",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./bus": "./dist/bus.js",
    "./fold": "./dist/fold.js",
    "./server": "./dist/server.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "antlegion-bus": "dist/index.js",
    "antlegion-mcp": "dist/mcp.js",
    "alctl": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mcp": "node dist/mcp.js",
    "bench": "tsx src/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Carter.Yang",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
