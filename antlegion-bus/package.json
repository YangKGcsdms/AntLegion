{
  "name": "@antlegion/bus",
  "version": "0.5.0",
  "description": "Append-only fact bus for autonomous agents — facts, not commands. Stateless trusted core, single total order, coordination as reader-side folds; SDK + alctl CLI (the sanctioned agent interface) included.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./bus": "./dist/bus.js",
    "./fold": "./dist/fold.js",
    "./server": "./dist/server.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "bus": "dist/index.js",
    "antlegion": "dist/index.js",
    "alctl": "dist/bin.js"
  },
  "files": [
    "dist",
    "demo",
    "console",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "bench": "tsx src/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "ai-agents",
    "coordination",
    "fact-bus",
    "blackboard",
    "stigmergy",
    "tuple-space",
    "append-only",
    "event-log",
    "content-addressed",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YangKGcsdms/antlegion-platform.git",
    "directory": "antlegion-bus"
  },
  "homepage": "https://antlegion.dev",
  "bugs": {
    "url": "https://github.com/YangKGcsdms/antlegion-platform/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Carter.Yang",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
